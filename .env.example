# ==============================================================================
# SYRI AI - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Placeholders are used below; never commit real secrets or API keys.
# ==============================================================================

# Core Flask Application Settings (app/config.py)
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database Configuration (app/config.py)
DATABASE_URL=sqlite:///instance/syri.db

# Gnani AI Common Credentials & Gateway Settings (app/services/gnani_service.py, app/services/evon_service.py)
GNANI_API_KEY=your-gnani-api-key-here
GNANI_API_URL=https://api.vachana.ai/v1/chat/completions
GNANI_TIMEOUT_SECONDS=6

# Gnani Prisma Speech-to-Text (app/services/prisma_service.py)
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=en-IN

# Gnani Timbre Text-to-Speech (app/services/timbre_service.py)
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_LANGUAGE=en-IN
GNANI_TTS_VOICE=Nalini
GNANI_TTS_FORMAT=wav
GNANI_TTS_SAMPLE_RATE=24000
GNANI_TTS_CHANNELS=2

# Gnani Evon Multilingual Reasoning (app/services/evon_service.py)
GNANI_EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
# Optional overrides (defaults fallback to GNANI_API_KEY and GNANI_API_URL):
# GNANI_EVON_API_KEY=your-gnani-api-key-here
# GNANI_EVON_API_URL=https://api.vachana.ai/v1/chat/completions
